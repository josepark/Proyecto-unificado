# Copie este archivo a ".env" y ajuste los valores antes de desplegar.
# NUNCA suba el ".env" real a un repositorio.
#
# IMPORTANTE: las tres aplicaciones (Inventario, Riesgos, RBAC) se NIEGAN A
# ARRANCAR con DJANGO_DEBUG=False si detectan que DJANGO_SECRET_KEY,
# RIESGOS_SECRET_KEY, JWT_SHARED_SECRET o SUIIN_RBAC_SECRET siguen con el
# valor de ejemplo de este archivo (los que empiezan con "defina-") — hallazgo
# real de un despliegue que corrió así, en producción, sin que nada lo avisara.
# Genere un valor real para cada uno con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
# O, más simple, corra esto desde la raíz de la plataforma — detecta solas
# cuáles de las cuatro variables siguen con el valor de ejemplo y genera
# solo esas, sin tocar ninguna que ya haya configurado:
#   python3 generar_secretos.py

# --- Inventario de Activos SGSI (Django) ---
DJANGO_SECRET_KEY=defina-una-clave-larga-y-aleatoria-aqui

# Sesión única entre el Inventario y SUIIN-SGSI-RIESGOS: el Inventario emite un
# JWT firmado con esta clave (endpoint /api/token-jwt/), y Riesgos lo verifica
# con la MISMA clave — a propósito compartida entre los dos servicios, a
# diferencia de DJANGO_SECRET_KEY/RIESGOS_SECRET_KEY (esas sí deben ser
# distintas por app). Sin esta variable, cada módulo sigue funcionando con su
# propio login por separado — ver README-DESPLIEGUE.md sección 11.
JWT_SHARED_SECRET=defina-una-cuarta-clave-larga-y-aleatoria-aqui
# Minutos de vigencia de cada JWT emitido (el frontend pide uno nuevo cuando
# expira; no hace falta que dure mucho).
JWT_EXPIRACION_MINUTOS=30
DJANGO_DEBUG=False
# Incluya el/los dominios o IP con los que se accederá a la plataforma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,suiin.cric.local
# Requerido si DJANGO_DEBUG=False y se sirve por HTTPS con dominio propio
DJANGO_CSRF_TRUSTED=https://suiin.cric.local
# En este despliegue nginx atiende en HTTP interno de la VLAN; si nginx mismo
# termina TLS, deje esto en True. Si hay otro balanceador/proxy con TLS
# delante de este stack, puede requerir ponerlo en False para evitar bucles
# de redirección.
DJANGO_SSL_REDIRECT=False

# URL interna de RBAC dentro de la red de docker-compose, usada para el
# Panel ejecutivo unificado y el cruce en vivo de Roles/Sistemas (sección 8
# del README). El valor por defecto ya coincide con el nombre del servicio
# en docker-compose.yml; solo cámbielo si renombra ese servicio.
# RBAC_INTERNAL_URL=http://rbac:5000

# Descomente y complete estas variables para migrar de SQLite a PostgreSQL
# (recomendado en producción, según el propio README del inventario):
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=suiin_inventario
# DJANGO_DB_USER=suiin
# DJANGO_DB_PASSWORD=defina-una-contrasena-fuerte
# DJANGO_DB_HOST=postgres
# DJANGO_DB_PORT=5432

# Notificaciones proactivas por correo (resumen semanal de alertas, sección
# 10 del README-DESPLIEGUE.md). Sin DJANGO_EMAIL_HOST, los correos se
# imprimen en los logs del contenedor en vez de enviarse de verdad — útil
# para probar el comando antes de tener SMTP configurado.
# DJANGO_EMAIL_HOST=smtp.office365.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USER=suiin-sgsi@cric.org.co
# DJANGO_EMAIL_PASSWORD=defina-la-contrasena-o-app-password-del-correo
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_EMAIL_FROM=suiin-sgsi@cric.org.co
# Uno o varios correos separados por coma; sin esto, el comando
# enviar_resumen_alertas no envía nada (avisa en el log, no falla).
# DJANGO_ALERTAS_EMAIL=seguridad@cric.org.co,dinamizador@cric.org.co

# --- SUIIN-RBAC (Flask) ---
SUIIN_RBAC_SECRET=defina-otra-clave-larga-y-aleatoria-aqui

# --- SUIIN-SGSI-RIESGOS (Django) — gestión de riesgos y plan de tratamiento ---
# Clave propia, distinta de DJANGO_SECRET_KEY de arriba (que es del inventario) —
# ver la nota en docker-compose.yml sobre por qué no se comparte.
RIESGOS_SECRET_KEY=defina-una-tercera-clave-larga-y-aleatoria-aqui
# Opcional — correos que reciben el resumen de vencimientos
# (enviar_alertas_vencimiento). Sin esto, el comando no envía nada.
# RIESGOS_ALERTAS_EMAIL_DESTINATARIOS=seguridad@cric.org.co
# Solo si necesita apuntar a un inventario en otra URL que no sea el servicio
# 'inventario' de este mismo docker-compose (poco común):
# INVENTARIO_API_URL=http://inventario:8000/api

# Variables de entorno para despliegue seguro. Copiar a .env y ajustar.
# En desarrollo NO es necesario definir nada (los valores por defecto funcionan).
# En la plataforma unificada use el .env.example de la raíz plataforma/.

DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=inventario.suiin.local,127.0.0.1
DJANGO_SSL_REDIRECT=True

# PostgreSQL (opcional; si no se define DJANGO_DB_ENGINE, usa SQLite)
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=suiin_inventario
# DJANGO_DB_USER=suiin
# DJANGO_DB_PASSWORD=...
# DJANGO_DB_HOST=postgres
# DJANGO_DB_PORT=5432
# RBAC_DB_NAME=suiin_rbac
# RBAC_BACKEND=django

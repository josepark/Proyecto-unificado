# Variables de entorno para despliegue seguro. Copiar a .env y ajustar.
# En desarrollo NO es necesario definir nada (los valores por defecto funcionan).

DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=inventario.suiin.local,127.0.0.1
DJANGO_SSL_REDIRECT=True

# PostgreSQL (opcional; si no se define, usa SQLite)

# Copie este archivo a .env y ajuste los valores para su entorno.
# En desarrollo local, ninguna de estas variables es obligatoria: el proyecto
# funciona con SQLite y valores por defecto sin configuración adicional.

DJANGO_SECRET_KEY=cambie-esto-por-una-clave-larga-y-aleatoria-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Correo para el resumen de vencimientos (ver `enviar_alertas_vencimiento`).
# Sin configurar, los correos se imprimen en la consola — no hace falta nada
# para probarlo en desarrollo.
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp.gmail.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_HOST_USER=
# DJANGO_EMAIL_HOST_PASSWORD=
# DJANGO_EMAIL_USE_TLS=True
# DJANGO_DEFAULT_FROM_EMAIL=suiin-sgsi@cric.org.co
ALERTAS_EMAIL_DESTINATARIOS=

# Deje DJANGO_DB_ENGINE sin definir para usar SQLite (por defecto).
# Para integrarlo al stack SUIIN Platform (docker-compose con PostgreSQL):
# DJANGO_DB_ENGINE=postgresql
# DJANGO_DB_NAME=suiin_riesgos
# DJANGO_DB_USER=suiin
# DJANGO_DB_PASSWORD=
# DJANGO_DB_HOST=localhost
# DJANGO_DB_PORT=5432
